{
  "title": "Diem Danh - System Overview (De 27)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Container CPU Usage",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]) * 100", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Container Memory Usage (MB)",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "container_memory_rss{name!=\"\"} / 1024 / 1024", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "MySQL Connections",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "targets": [{ "expr": "mysql_global_status_threads_connected" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "MySQL Uptime (Hours)",
      "datasource": "Prometheus",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 6 },
      "targets": [{ "expr": "mysql_global_status_uptime / 3600" }]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Recent backend errors",
      "datasource": "Loki",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "{compose_service=\"backend\"} |= \"error\"" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Disk usage %",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 6 },
      "targets": [
        { "expr": "(node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100" }
      ]
    }
  ]
}
